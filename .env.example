# Local development: copy to .env.after (and run `npm run dev:after`)
DEMO_STAGE=after
DATABASE_URI=file:./after.db
PAYLOAD_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=          # optional; without it the AI steps run in the rule-based stored mode
DEMO_AI=stored              # stored | live

# Production (Railway): see README "Deploy to Railway"
# DEMO_STAGE=after
# DATABASE_URI=file:/data/app.db
# MEDIA_DIR=/data/media
# PAYLOAD_SECRET=<long random string>
# SEED_PASSWORD=<password for the seeded demo logins>
# APP_URL=https://<your-domain>   # optional; Railway's public domain is used if unset
